# Copy to .env and edit. NEVER commit a real .env.
#
# Which hardware tier to run. CPU | LAPTOP | T4 | BIGGPU
# See HARDWARE-GUIDE.md. NB1 and the test suite run on CPU; training does not.
COMPUTE_TIER=T4

# Loss-mask mode for NB3. assistant-only | masked-think | response-only | everything
#   assistant-only  default SFT
#   masked-think    reasoning base, keep traces out of the loss  (deck §13.5)
#   response-only   strictest
#   everything      the classic bug — set this ONLY to reproduce it deliberately
MASK_MODE=assistant-only

# Epochs for NB3. 1-3; >3 overfits a few-hundred-sample set almost every time.
EPOCHS=2

# Smoke mode: truncate BOTH eval sets to N items so NB2/NB5 finish fast on slow
# hardware. A SUBMITTED run must leave this unset — results/ records that it was used.
# EVAL_LIMIT=8

# Optional. Raises HF Hub rate limits; not required for this lab.
# HF_TOKEN=hf_xxx
