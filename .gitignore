# Python
__pycache__/
*.py[cod]
.venv*/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
# notebooks/*.py (jupytext) is the source of truth and IS committed.
# colab/*.ipynb is generated and IS committed (students launch from it).

# Lab artifacts — regenerated by the notebooks, not committed in the clean template.
# EXCEPTION for this submission: rubric.md requires results/ (all json+csv), the
# `correct` adapter, and data/split/ inside the repo/zip the grader cross-checks
# against submission/REPORT.md. Other contrast adapters (attn_only/wrong_lr/qlora)
# stay ignored -- rubric explicitly says the grader does not need them.
# NOTE: a directory pattern (trailing /) stops git from descending into it at all, so a
# `!` exception for a file *inside* an ignored directory has no effect unless the
# directory pattern itself is un-ignored first (or the directory is matched with `*`
# instead of `/`, as below).
adapters/*
!adapters/.gitkeep
!adapters/correct/
# The adapter weights themselves are NOT pushed to this GitHub fork: LFS uploads to
# public forks are blocked by GitHub ("can not upload new objects to public fork").
# The weights live on HuggingFace Hub instead -- see submission/REPORT.md for the link.
# Everything else in adapters/correct/ (config, tokenizer files) is small and stays.
adapters/correct/*.safetensors
data/split/*
!data/split/train.jsonl
!data/split/val.jsonl
data/CUSTOM_DATASET.md
results/*
!results/.gitkeep
!results/*.json
!results/*.csv
gguf/
*.gguf
runs/
wandb/

# Model / HF cache
.cache/
hf_cache/

# Secrets
.env
.env.local
*.token

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
